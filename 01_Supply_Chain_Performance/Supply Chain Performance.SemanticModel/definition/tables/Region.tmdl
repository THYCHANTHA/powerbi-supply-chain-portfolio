	partition Region = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "dim_region.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"Region Id", Int64.Type}, {"Market", type text}, {"Region", type text}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table

