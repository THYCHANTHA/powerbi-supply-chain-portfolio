	partition Customer = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "dim_customer.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"Customer Id", Int64.Type}, {"Segment", type text}, {"State", type text}, {"Country", type text}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table

