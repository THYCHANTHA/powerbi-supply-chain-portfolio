	partition Product = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "dim_product.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"Product Id", Int64.Type}, {"Product Name", type text}, {"Category", type text}, {"Department", type text}, {"List Price", type number}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table

