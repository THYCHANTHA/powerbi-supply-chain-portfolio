model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["DataFolder", "Shipment Lines", "Key Measures", "Vendor", "Item", "Country", "Date"]

annotation PBI_ProTooling = ["DevMode"]

ref table 'Shipment Lines'
ref table 'Key Measures'
ref table Vendor
ref table Item
ref table Country
ref table Date

