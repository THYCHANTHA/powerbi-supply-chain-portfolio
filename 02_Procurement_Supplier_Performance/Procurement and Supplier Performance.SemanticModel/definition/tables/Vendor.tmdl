	partition Vendor = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "dim_vendor.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"Vendor", type text}, {"Supplier Type", type text}, {"Supplier", type text}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table

