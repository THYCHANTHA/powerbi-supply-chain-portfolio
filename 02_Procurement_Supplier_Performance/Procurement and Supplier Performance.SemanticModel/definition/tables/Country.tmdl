table Country
	lineageTag: 4c2e3859-8a8e-593e-8da0-4a2f9031fc6b

	column Country
		dataType: string
		lineageTag: 0e9e51ae-ad76-5b3b-9452-285ad94c7940
		dataCategory: Country
		summarizeBy: none
		sourceColumn: Country

