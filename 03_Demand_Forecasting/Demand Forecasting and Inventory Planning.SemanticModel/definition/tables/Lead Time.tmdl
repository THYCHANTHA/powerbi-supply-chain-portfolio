/// What-if: supplier lead time in weeks.
table 'Lead Time'
	lineageTag: 088b0e5d-9577-517a-abe1-134621e63697

	column 'Lead Time Weeks'
		dataType: int64
		lineageTag: f8b10a58-de18-5a42-b66f-9a33adf2a6d1
		summarizeBy: none
		sourceColumn: Lead Time Weeks

		annotation SummarizationSetBy = User

	partition 'Lead Time' = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "dim_lead_time.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"Lead Time Weeks", Int64.Type}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table

