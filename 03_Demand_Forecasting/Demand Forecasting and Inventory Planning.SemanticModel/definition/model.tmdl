model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["DataFolder", "Weekly Sales", "Forecast", "Model Accuracy", "Key Measures", "Product", "Week", "Model", "Service Level", "Lead Time"]

annotation PBI_ProTooling = ["DevMode"]

ref table 'Weekly Sales'
ref table Forecast
ref table 'Model Accuracy'
ref table 'Key Measures'
ref table Product
ref table Week
ref table Model
ref table 'Service Level'
ref table 'Lead Time'

