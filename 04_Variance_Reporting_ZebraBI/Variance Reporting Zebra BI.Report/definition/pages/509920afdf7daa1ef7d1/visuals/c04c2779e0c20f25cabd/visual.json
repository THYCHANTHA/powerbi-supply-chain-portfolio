    "objects": {
      "general": [
        {
          "properties": {
            "paragraphs": [
              {
                "textRuns": [
                  {
                    "value": "Why use Zebra BI here",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "12pt",
                      "color": "#12355B"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "■ Variance is drawn, not read: ",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "9pt",
                      "color": "#1F2933"
                    }
                  },
                  {
                    "value": "red and green bars show the gap to plan and PY without comparing three bar lengths by eye.",
                    "textStyle": {
                      "fontSize": "9pt",
                      "color": "#5C6B73"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "■ Value and gap together: ",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "9pt",
                      "color": "#1F2933"
                    }
                  },
                  {
                    "value": "actual, variance and % variance in one visual, with a hierarchy you can expand.",
                    "textStyle": {
                      "fontSize": "9pt",
                      "color": "#5C6B73"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "■ Standard notation (IBCS): ",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "9pt",
                      "color": "#1F2933"
                    }
                  },
                  {
                    "value": "AC solid, PY grey, PL outlined. Finance readers know it.",
                    "textStyle": {
                      "fontSize": "9pt",
                      "color": "#5C6B73"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "■ Same measures: ",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "9pt",
                      "color": "#1F2933"
                    }
                  },
                  {
                    "value": "both sides use the same DAX measures, so the numbers match.",
                    "textStyle": {
                      "fontSize": "9pt",
                      "color": "#5C6B73"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "■ Cost: ",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "9pt",
                      "color": "#1F2933"
                    }
                  },
                  {
                    "value": "the free version allows two measures per visual, the chart view only, and no colour invert. AC vs PL and PY in one table needs Pro. Check what the client has.",
                    "textStyle": {
                      "fontSize": "9pt",
                      "color": "#5C6B73"
                    }
                  }
                ]
              }
            ]
          }
        }
      ]
