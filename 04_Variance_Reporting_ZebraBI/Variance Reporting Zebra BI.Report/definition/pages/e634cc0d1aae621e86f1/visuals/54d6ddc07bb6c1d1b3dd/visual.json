          "properties": {
            "paragraphs": [
              {
                "textRuns": [
                  {
                    "value": "What the variance shows",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "12pt",
                      "color": "#12355B"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "■ On plan in total: ",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "9.5pt",
                      "color": "#1F2933"
                    }
                  },
                  {
                    "value": "net sales +0.1% vs plan and +4.7% vs PY.",
                    "textStyle": {
                      "fontSize": "9.5pt",
                      "color": "#5C6B73"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "■ The core missed plan: ",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "9.5pt",
                      "color": "#1F2933"
                    }
                  },
                  {
                    "value": "Fan Shop −2.5%, Apparel −5.1%, Golf −3.6%. These three are 83% of sales.",
                    "textStyle": {
                      "fontSize": "9.5pt",
                      "color": "#5C6B73"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "■ Small departments filled the gap: ",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "9.5pt",
                      "color": "#1F2933"
                    }
                  },
                  {
                    "value": "Outdoors +91% and Fitness +70% vs plan, from products added in Q2–Q3 2017.",
                    "textStyle": {
                      "fontSize": "9.5pt",
                      "color": "#5C6B73"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "■ Action: ",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "9.5pt",
                      "color": "#1F2933"
                    }
                  },
                  {
                    "value": "the total hides a weak core. Review Fan Shop and Apparel pricing and range before planning on Outdoors growth again.",
                    "textStyle": {
                      "fontSize": "9.5pt",
                      "color": "#5C6B73"
                    }
                  }
                ]
              }
            ]
          }
        }
