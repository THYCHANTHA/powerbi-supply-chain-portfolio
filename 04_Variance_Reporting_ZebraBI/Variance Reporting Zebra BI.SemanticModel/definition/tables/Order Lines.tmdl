	partition 'Order Lines' = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "fact_order_lines.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"Order Id", Int64.Type}, {"Order Date", type date}, {"Product Id", Int64.Type}, {"Shipping Mode", type text}, {"Is Late", Int64.Type}, {"Is Cancelled", Int64.Type}, {"Actual Ship Days", Int64.Type}, {"Scheduled Ship Days", Int64.Type}, {"Net Sales", type number}, {"Profit", type number}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table
