table Product
	lineageTag: 07c01648-4dc5-5b8d-964a-0a9e012228e4

	column 'Product Id'
		dataType: int64
		isHidden
		lineageTag: c82d7b6b-6001-52f6-927f-ad9b090de5d4
		summarizeBy: none
		sourceColumn: Product Id

		annotation SummarizationSetBy = User

	column 'Product Name'
		dataType: string
		lineageTag: 90b9df76-d5c5-5375-bb62-4d10bfadd85c
		summarizeBy: none
		sourceColumn: Product Name

		annotation SummarizationSetBy = User

	column Category
		dataType: string
		lineageTag: 52832b3a-9905-5d2b-be04-10d275eb61ca
		summarizeBy: none
		sourceColumn: Category

		annotation SummarizationSetBy = User

	column Department
		dataType: string
		lineageTag: 712970dc-add3-5d89-a701-3e46d0e1147c
		summarizeBy: none
		sourceColumn: Department

		annotation SummarizationSetBy = User

	column 'List Price'
		dataType: double
		formatString: \$#,0.00
		lineageTag: ba8feedf-e429-5682-860a-08ffa0ff93e9
		summarizeBy: none
		sourceColumn: List Price

		annotation SummarizationSetBy = User

	partition Product = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "dim_product.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"Product Id", Int64.Type}, {"Product Name", type text}, {"Category", type text}, {"Department", type text}, {"List Price", type number}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table
